generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  BASIC
  BUSINESS
  PREMIUM
}

enum BillingMarket {
  AZ
  GLOBAL
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Company {
  id                       String              @id @default(cuid())
  name                     String
  loginEmail               String              @unique
  passwordHash             String
  plan                     Plan                @default(BASIC)
  market                   BillingMarket       @default(AZ)
  billingCycle             BillingCycle        @default(MONTHLY)
  currency                 String              @default("AZN")
  locale                   String              @default("az")
  isActive                 Boolean             @default(false)
  startsAt                 DateTime            @default(now())
  endsAt                   DateTime?
  authVersion              Int                 @default(0)
  legacyUploads            Boolean             @default(false)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  categoryRecords          Category[]
  productRecords           Product[]
  purchaseRecords          Purchase[]
  purchaseItemRecords      PurchaseItem[]
  stockRecords             Stock[]
  areaRecords              Area[]
  customerRecords          Customer[]
  userRecords              User[]
  orderRecords             Order[]
  orderItemRecords         OrderItem[]
  returnRecords            Return[]
  returnItemRecords        ReturnItem[]
  paymentRecords           Payment[]
  paymentSoldItemRecords   PaymentSoldItem[]
  orderEditLogRecords      OrderEditLog[]
  driverLiveSessionRecords DriverLiveSession[]
}

model Category {
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  id        String    @id @default(cuid())
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([companyId, id])
  @@unique([companyId, name])
}

model Product {
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  id         String   @id @default(cuid())
  name       String
  categoryId String
  category   Category @relation(fields: [companyId, categoryId], references: [companyId, id])

  stock     Stock?
  salePrice Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems       OrderItem[]
  returnItems      ReturnItem[]
  purchaseItems    PurchaseItem[]
  paymentSoldItems PaymentSoldItem[]

  @@unique([companyId, name, categoryId])
  @@unique([companyId, id])
}

model Purchase {
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  id          String   @id @default(cuid())
  createdById String
  createdBy   User     @relation(fields: [companyId, createdById], references: [companyId, id])
  supplier    String?
  invoiceNo   String?
  note        String?
  createdAt   DateTime @default(now())

  items PurchaseItem[]

  @@unique([companyId, id])
}

model PurchaseItem {
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  unitCost   Float    @default(0)
  createdAt  DateTime @default(now())

  purchase Purchase @relation(fields: [companyId, purchaseId], references: [companyId, id], onDelete: Cascade)
  product  Product  @relation(fields: [companyId, productId], references: [companyId, id])

  @@unique([companyId, id])
}

model Stock {
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  productId String   @id
  product   Product  @relation(fields: [companyId, productId], references: [companyId, id])
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([companyId, productId])
}

model Area {
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  id        String   @id @default(cuid())
  name      String
  routeZone String?
  routeDay  Int?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers Customer[]
  orders    Order[]

  @@unique([companyId, id])
  @@unique([companyId, name])
}

model Customer {
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  id        String  @id @default(cuid())
  name      String
  phone     String?
  salon     String?
  address   String?
  lat       Float?
  lng       Float?

  areaId String?
  area   Area?   @relation(fields: [companyId, areaId], references: [companyId, id], onDelete: Restrict)

  assignedExpeditorId String?
  assignedExpeditor   User?   @relation("CustomerAssignedExpeditor", fields: [companyId, assignedExpeditorId], references: [companyId, id], onDelete: Restrict)

  isProblematic   Boolean   @default(false)
  problemNote     String?
  problemMarkedAt DateTime?

  orders   Order[]
  returns  Return[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, id])
}

enum PaymentType {
  REALİZASİYA
  NAĞD
  HİSSƏLİ
  DİGƏR
}

enum UserRole {
  ADMIN
  EXPEDITOR
  WAREHOUSE
  DRIVER
}

model User {
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  id          String   @id @default(cuid())
  fullName    String   @default("User")
  authVersion Int      @default(0)
  pinHash     String   @default("")
  isActive    Boolean  @default(true)
  email       String?
  password    String?
  role        UserRole @default(DRIVER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders            Order[]             @relation("OrderCreatedBy")
  editedOrders      Order[]             @relation("OrderEditedBy")
  returns           Return[]
  purchases         Purchase[]
  paymentsCreated   Payment[]           @relation("PaymentCreatedBy")
  assignedCustomers Customer[]          @relation("CustomerAssignedExpeditor")
  liveSessions      DriverLiveSession[]
  orderEditLogs     OrderEditLog[]

  @@unique([companyId, id])
  @@unique([companyId, email])
}

model Order {
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  id          String  @id @default(cuid())
  orderNumber Int     @unique @default(autoincrement())

  customerId String
  customer   Customer @relation(fields: [companyId, customerId], references: [companyId, id])

  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [companyId, createdById], references: [companyId, id])

  paymentType PaymentType
  note        String?

  areaId String?
  area   Area?   @relation(fields: [companyId, areaId], references: [companyId, id], onDelete: Restrict)

  deliveryStatus DeliveryStatus @default(IN_WAREHOUSE)
  deliveredAt    DateTime?

  isLocked Boolean @default(false)

  lastEditedById String?
  lastEditedBy   User?     @relation("OrderEditedBy", fields: [companyId, lastEditedById], references: [companyId, id], onDelete: Restrict)
  lastEditedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sellerSignature   String?
  sellerSignedAt    DateTime?
  customerSignature String?
  signedAt          DateTime?

  items    OrderItem[]
  editLogs OrderEditLog[]

  @@unique([companyId, id])
  @@index([customerId])
  @@index([createdById])
  @@index([areaId])
  @@index([deliveryStatus])
  @@index([createdAt])
  @@index([deliveredAt])
}

model OrderItem {
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  returnedQty Int     @default(0)
  isGift      Boolean @default(false)

  order       Order        @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Cascade)
  product     Product      @relation(fields: [companyId, productId], references: [companyId, id])
  returnItems ReturnItem[]

  @@unique([companyId, id])
  @@index([orderId])
  @@index([productId])
}

model Return {
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [companyId, customerId], references: [companyId, id])
  createdById String
  createdBy   User     @relation(fields: [companyId, createdById], references: [companyId, id])
  note        String?
  createdAt   DateTime @default(now())

  items ReturnItem[]

  @@unique([companyId, id])
}

model ReturnItem {
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  id          String   @id @default(cuid())
  returnId    String
  orderItemId String?
  productId   String
  quantity    Int
  unitPrice   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  returnDoc Return     @relation(fields: [companyId, returnId], references: [companyId, id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [companyId, orderItemId], references: [companyId, id], onDelete: Restrict)
  product   Product    @relation(fields: [companyId, productId], references: [companyId, id])

  @@unique([companyId, id])
  @@index([returnId])
  @@index([orderItemId])
  @@index([productId])
}

model Payment {
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  id          String    @id @default(cuid())
  customerId  String
  createdById String?
  amount      Float
  paymentType String?
  paymentDate DateTime?
  imageUrl    String?
  note        String?
  createdAt   DateTime  @default(now())

  customer  Customer @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Cascade)
  createdBy User?    @relation("PaymentCreatedBy", fields: [companyId, createdById], references: [companyId, id], onDelete: Restrict)

  soldItems PaymentSoldItem[]

  @@unique([companyId, id])
  @@index([customerId])
  @@index([createdById])
  @@index([createdAt])
}

model PaymentSoldItem {
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  id        String   @id @default(cuid())
  paymentId String
  productId String
  quantity  Int
  note      String?
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [companyId, paymentId], references: [companyId, id], onDelete: Cascade)
  product Product @relation(fields: [companyId, productId], references: [companyId, id])

  @@unique([companyId, id])
  @@index([paymentId])
  @@index([productId])
}

model OrderEditLog {
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  id             String   @id @default(cuid())
  orderId        String
  editedById     String
  reason         String?
  beforeSnapshot Json
  afterSnapshot  Json
  createdAt      DateTime @default(now())

  order    Order @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Cascade)
  editedBy User  @relation(fields: [companyId, editedById], references: [companyId, id])

  @@unique([companyId, id])
  @@index([orderId])
  @@index([editedById])
  @@index([createdAt])
}

model DriverLiveSession {
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  id        String  @id @default(cuid())
  driverId  String
  driver    User    @relation(fields: [companyId, driverId], references: [companyId, id], onDelete: Cascade)

  lat      Float
  lng      Float
  isActive Boolean @default(true)

  startedAt DateTime  @default(now())
  endedAt   DateTime?
  updatedAt DateTime  @updatedAt

  @@unique([companyId, id])
  @@index([driverId, isActive])
}

enum DeliveryStatus {
  IN_WAREHOUSE
  ON_BOARD
  DELIVERED
}
