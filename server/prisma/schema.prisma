generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  stock     Stock?
  salePrice Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems       OrderItem[]
  returnItems      ReturnItem[]
  purchaseItems    PurchaseItem[]
  paymentSoldItems PaymentSoldItem[]

  @@unique([name, categoryId])
}

model Purchase {
  id          String   @id @default(cuid())
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  supplier    String?
  invoiceNo   String?
  note        String?
  createdAt   DateTime @default(now())

  items PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  unitCost   Float    @default(0)
  createdAt  DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

model Stock {
  productId String   @id
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Area {
  id        String   @id @default(cuid())
  name      String   @unique
  routeZone String?
  routeDay  Int?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers Customer[]
  orders    Order[]
}

model Customer {
  id      String  @id @default(cuid())
  name    String
  phone   String?
  salon   String?
  address String?
  lat     Float?
  lng     Float?

  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id])

  assignedExpeditorId String?
  assignedExpeditor   User?   @relation("CustomerAssignedExpeditor", fields: [assignedExpeditorId], references: [id])

  isProblematic   Boolean   @default(false)
  problemNote     String?
  problemMarkedAt DateTime?

  orders   Order[]
  returns  Return[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentType {
  REALİZASİYA
  NAĞD
  HİSSƏLİ
  DİGƏR
}

enum UserRole {
  ADMIN
  EXPEDITOR
  WAREHOUSE
  DRIVER
}

model User {
  id        String   @id @default(cuid())
  fullName  String   @default("User")
  pinHash   String   @default("")
  isActive  Boolean  @default(true)
  email     String?  @unique
  password  String?
  role      UserRole @default(DRIVER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders            Order[]             @relation("OrderCreatedBy")
  editedOrders      Order[]             @relation("OrderEditedBy")
  returns           Return[]
  purchases         Purchase[]
  paymentsCreated   Payment[]           @relation("PaymentCreatedBy")
  assignedCustomers Customer[]          @relation("CustomerAssignedExpeditor")
  liveSessions      DriverLiveSession[]
  orderEditLogs     OrderEditLog[]
}

model Order {
  id          String @id @default(cuid())
  orderNumber Int    @unique @default(autoincrement())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  paymentType PaymentType
  note        String?

  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id])

  deliveryStatus DeliveryStatus @default(IN_WAREHOUSE)
  deliveredAt    DateTime?

  isLocked Boolean @default(false)

  lastEditedById String?
  lastEditedBy   User?     @relation("OrderEditedBy", fields: [lastEditedById], references: [id])
  lastEditedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sellerSignature String?
  sellerSignedAt  DateTime?
  customerSignature String?
  signedAt DateTime?

  items    OrderItem[]
  editLogs OrderEditLog[]

  @@index([customerId])
  @@index([createdById])
  @@index([areaId])
  @@index([deliveryStatus])
  @@index([createdAt])
  @@index([deliveredAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  returnedQty Int     @default(0)
  isGift      Boolean @default(false)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id])
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([productId])
}

model Return {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  note        String?
  createdAt   DateTime @default(now())

  items ReturnItem[]
}

model ReturnItem {
  id          String   @id @default(cuid())
  returnId    String
  orderItemId String?
  productId   String
  quantity    Int
  unitPrice   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  returnDoc Return     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])
  product   Product    @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([orderItemId])
  @@index([productId])
}

model Payment {
  id          String   @id @default(cuid())
  customerId  String
  createdById String?
  amount      Float
  paymentType String?
  paymentDate DateTime?
  imageUrl    String?
  note        String?
  createdAt   DateTime @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  soldItems PaymentSoldItem[]

  @@index([customerId])
  @@index([createdById])
  @@index([createdAt])
}

model PaymentSoldItem {
  id         String   @id @default(cuid())
  paymentId  String
  productId  String
  quantity   Int
  note       String?
  createdAt  DateTime @default(now())

  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([paymentId])
  @@index([productId])
}

model OrderEditLog {
  id             String   @id @default(cuid())
  orderId        String
  editedById     String
  reason         String?
  beforeSnapshot Json
  afterSnapshot  Json
  createdAt      DateTime @default(now())

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  editedBy User  @relation(fields: [editedById], references: [id])

  @@index([orderId])
  @@index([editedById])
  @@index([createdAt])
}

model DriverLiveSession {
  id       String @id @default(cuid())
  driverId String
  driver   User   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  lat      Float
  lng      Float
  isActive Boolean @default(true)

  startedAt DateTime  @default(now())
  endedAt   DateTime?
  updatedAt DateTime  @updatedAt

  @@index([driverId, isActive])
}

enum DeliveryStatus {
  IN_WAREHOUSE
  ON_BOARD
  DELIVERED
}
