DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/hairerp?schema=public
PORT=7079
HOST=127.0.0.1
JWT_SECRET=
PLATFORM_OWNER_SECRET=
# Operator secret: at least 32 bytes; server only, never a VITE_ variable.
NODE_ENV=development
# Keep the existing uploads directory when upgrading. Absolute path in production.
# UPLOADS_DIR=C:/Users/Yunis/Desktop/miniERP/server/src/uploads
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
APP_URL=http://localhost:5173
SUPPORT_EMAIL=zindex.software@gmail.com
SERVICE_OPERATOR_NAME=z-Index
PRIVACY_EMAIL=zindex.software@gmail.com
DATA_REGION=
# DATA_RETENTION_DAYS=
BILLING_PROVIDER=manual
# Optional: sandbox first; never put these values in VITE_ variables.
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_MONTHLY_PRICE_ID=
PADDLE_YEARLY_PRICE_ID=
PADDLE_CHECKOUT_URL=
# Windows PostgreSQL 18 tools are detected automatically. Override if needed:
# PG_BIN=C:/Program Files/PostgreSQL/18/bin

# Optional Group 7 email delivery. Disabled by default; never expose these in VITE_.
REMINDERS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# A real, provider-verified sender email; not the company's fake sign-in email.
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Demo provisioning is optional and creates a NEW seven-day workspace only:
# DEMO_EMAIL=demo@your-company.invalid
# DEMO_PASSWORD=choose-a-new-strong-password
# DEMO_PIN=choose-4-to-8-digits

# Public seven-day signup. Production requires SMTP and a public HTTPS APP_URL.
# Local-only preview: NODE_ENV=development, TRIAL_EMAIL_MODE=console.
TRIAL_SIGNUP_ENABLED=false
TRIAL_EMAIL_MODE=smtp
# Enable after configuring Firebase Phone, the authorized domain, SMS regions and billing.
TRIAL_PHONE_ENABLED=false
